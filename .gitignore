# ============================================================
# 科技项目台账 — Git 忽略清单（G0 基线，2026-08-13）
#
# 原则：版本库只纳入源代码、设计文档、治理文件和测试；
#       正式数据、备份、真实导入/导出文件、可再生成产物
#       与本地运行目录一律不入库。
# ============================================================

# ---- 正式数据与备份：严禁入库 ----
data/project.db
data/*.db
data/*.db-*
backups/
imports/
exports/

# ---- 可再生成产物 ----
# 导入模板(xlsx，由 make_template.py 再生成)与真实导入原件均不入库
*.xlsx
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---- 本地运行/工具目录 ----
.reasonix/
.venv/
venv/
*.log

# ---- 编辑器和系统临时文件 ----
.idea/
.vscode/
*.swp
*.tmp
~$*
Thumbs.db
